# Copy this file to .env.local and replace values as you configure each service.
# Never commit .env.local or put passwords in source code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app settings (the public web config values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ADMIN_EMAILS=

# Contact form email. Keep SMTP_PASS private in .env.local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Set the owner's receiving inbox here. The original guide suggests info@addcreatives.com.
CONTACT_TO_EMAIL=info@addcreatives.com
CONTACT_FROM_NAME=ADD Creatives Website

# Optional durable copy of enquiries in Firestore.
# Create a Firebase service account and keep its private key secret.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
